; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Yesteryear"
config/description="Third Moon Interactive - an interactive Star Trek story built on the Vulcan Fury framework."
run/main_scene="res://scenes/watch/WatchThrough.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[autoload]

PauseKey="*res://autoload/PauseKey.gd"
GameState="*res://autoload/GameState.gd"
GameSettings="*res://autoload/GameSettings.gd"
UITheme="*res://autoload/UITheme.gd"
DisplayManager="*res://autoload/DisplayManager.gd"
EquipmentManager="*res://autoload/EquipmentManager.gd"
InventoryManager="*res://autoload/InventoryManager.gd"
MissionLog="*res://autoload/MissionLog.gd"
ObjectiveManager="*res://autoload/ObjectiveManager.gd"
AudioSubtitleManager="*res://autoload/AudioSubtitleManager.gd"
DialogueManager="*res://autoload/DialogueManager.gd"
InteractionManager="*res://autoload/InteractionManager.gd"
SaveSystem="*res://autoload/SaveSystem.gd"
SfxManager="*res://autoload/SfxManager.gd"
CollectorCards="*res://autoload/CollectorCards.gd"
PhotoMode="*res://autoload/PhotoMode.gd"
DevMenu="*res://autoload/DevMenu.gd"
BuildInfo="*res://autoload/BuildInfo.gd"
InvestigationSystem="*res://autoload/InvestigationSystem.gd"
WorldState="*res://autoload/WorldState.gd"
BanterManager="*res://autoload/BanterManager.gd"
CompanionManager="*res://autoload/CompanionManager.gd"
CinematicDirector="*res://autoload/CinematicDirector.gd"
ConversationPresenter="*res://autoload/ConversationPresenter.gd"
LookEnhancer="*res://autoload/LookEnhancer.gd"
InputHints="*res://autoload/InputHints.gd"
NameTags="*res://autoload/NameTags.gd"
Chapters="*res://autoload/Chapters.gd"
AmbientGlances="*res://autoload/AmbientGlances.gd"
PhaserControl="*res://autoload/PhaserControl.gd"
FaceLight="*res://autoload/FaceLight.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

movie_writer/mjpeg_quality=0.95

